<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste de SafeLink.

  Principe : le minimum de permissions. INTERNET sert uniquement à la
  vérification en ligne, activée par défaut et désactivable (ADR 0010 à
  0013), toujours en HTTPS. CAMERA sera ajoutée avec le scanner
  QR (lot E). Le partage entrant, l'action de sélection de texte et la
  tuile du volet (texte seulement) ne demandent aucune permission. La CI échoue si l'APK release contient une permission hors de
  la liste autorisée (tools/check_apk_permissions.sh).

  Les sauvegardes cloud et les transferts d'appareil sont désactivés :
  l'historique local ne doit jamais quitter le téléphone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="SafeLink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Thème appliqué derrière l'interface Flutter une fois affichée. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              « Partager → SafeLink » depuis une autre application : texte
              seulement (ADR 0004). Aucune permission n'est nécessaire ; un
              fichier joint au partage n'est jamais ouvert.
            -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              « Vérifier avec SafeLink » dans le menu de sélection de texte
              des autres applications (ADR 0014). Le texte sélectionné n'est
              jamais modifié en retour.
            -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
          Entrée réservée à la tuile du volet (et plus tard à la bulle) :
          ouvre SafeLink et lui demande de vérifier le texte copié. Non
          exportée : aucune autre application ne peut la déclencher.
        -->
        <activity-alias
            android:name=".ClipboardCheck"
            android:targetActivity=".MainActivity"
            android:exported="false" />
        <!--
          Tuile « SafeLink » des réglages rapides (ADR 0014) : aucune
          permission demandée ; BIND_QUICK_SETTINGS_TILE protège le service
          (seul le système peut s'y lier).
        -->
        <service
            android:name=".ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Requis par l'outillage Flutter (GeneratedPluginRegistrant). -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!--
      Visibilité limitée aux applications qui traitent du texte sélectionné
      (menu « Traduire », etc. dans les champs de saisie Flutter) et aux
      moteurs de synthèse vocale.
      Ce n'est pas une permission et cela ne donne pas accès à la liste des
      applications installées.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Voix du téléphone, pour le bouton « Écouter » (lecture à voix
             haute, sans connexion). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
