<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste de SafeLink.

  Principe : le minimum de permissions. INTERNET sert uniquement à la
  vérification en ligne, activée par défaut et désactivable (ADR 0010 à
  0013), toujours en HTTPS. CAMERA sera ajoutée avec le scanner
  QR (lot E). La CI échoue si l'APK release contient une permission hors de
  la liste autorisée (tools/check_apk_permissions.sh).

  Les sauvegardes cloud et les transferts d'appareil sont désactivés :
  l'historique local ne doit jamais quitter le téléphone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="SafeLink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Thème appliqué derrière l'interface Flutter une fois affichée. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Requis par l'outillage Flutter (GeneratedPluginRegistrant). -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!--
      Visibilité limitée aux applications qui traitent du texte sélectionné
      (menu « Traduire », etc. dans les champs de saisie Flutter) et aux
      moteurs de synthèse vocale.
      Ce n'est pas une permission et cela ne donne pas accès à la liste des
      applications installées.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Voix du téléphone, pour le bouton « Écouter » (lecture à voix
             haute, sans connexion). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
